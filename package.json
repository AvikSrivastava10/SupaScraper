{
  "name": "supascraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test \"apps/*/tests/*.test.ts\"",
    "verify": "npm run build && npm test",
    "start:target": "node --env-file-if-exists=.env apps/target-site/dist/server.js",
    "start:app": "node --env-file-if-exists=.env apps/supascraper/dist/main.js",
    "layout": "node scripts/set-layout.mjs"
  },
  "devDependencies": {
    "@brightdata/cli": "0.3.5",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
