# Copy to .env and fill in. Never commit .env.

# --- Bright Data ------------------------------------------------------------
# Optional. `brightdata login` stores a key in the OS config directory instead,
# which is preferred for local use. Set this only for non-interactive runs.
BRIGHTDATA_API_KEY=

# --- SupaScraper application ------------------------------------------------
# Existing collector to reuse. The app never creates one.
SUPASCRAPER_COLLECTOR_ID=c_replace_me
SUPASCRAPER_TARGET_URL=https://replace-me.example/catalog
SUPASCRAPER_FIELD_DESCRIPTION="Extract product name, SKU, numeric price, and availability."

# A run polls for seconds to a few minutes.
SUPASCRAPER_RUN_TIMEOUT_MS=420000

# Loopback by default. Binding elsewhere requires SUPASCRAPER_API_TOKEN, because
# the run endpoint consumes Bright Data credit.
SUPASCRAPER_HOST=127.0.0.1
SUPASCRAPER_PORT=3000
SUPASCRAPER_API_TOKEN=

# Verified data and repair history, so they survive a restart.
SUPASCRAPER_DATA_PATH=./data/supascraper-state.json

# Automatic repair. Off by default: healing mutates the hosted collector and
# spends credit. Only a structural break above the confidence threshold heals,
# and the fix is still reviewed before approval and verified after it.
SUPASCRAPER_AUTO_HEAL=false

# --- Optional reasoning layer (Phase 5) -------------------------------------
SUPASCRAPER_GEMINI_ENABLED=false
GEMINI_API_KEY=

# --- Controlled target site -------------------------------------------------
# A platform-injected PORT takes precedence over TARGET_SITE_PORT.
TARGET_SITE_PORT=3001
TARGET_STATE_PATH=./data/target-scenario.json

# Generated by Render. Copy it from the service's Environment tab.
TARGET_CONTROL_TOKEN=replace-with-a-long-random-value

# Used by scripts/set-layout.mjs; defaults to the deployed target.
TARGET_BASE_URL=https://supascraper-target.onrender.com
