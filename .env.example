# Bright Data authentication
# Optional. Only needed for non-interactive runs; `brightdata login` stores a key
# in the OS config directory instead. Read by the CLI as BRIGHTDATA_API_KEY.
BRIGHTDATA_API_KEY=

# SupaScraper application
SUPASCRAPER_COLLECTOR_ID=c_replace_me
SUPASCRAPER_TARGET_URL=https://replace-me.example/catalog
SUPASCRAPER_FIELD_DESCRIPTION="Extract product name, SKU, numeric price, and availability."
SUPASCRAPER_RUN_TIMEOUT_MS=120000
SUPASCRAPER_PORT=3000
SUPASCRAPER_RUN_TIMEOUT_MS=120000
SUPASCRAPER_GEMINI_ENABLED=false
GEMINI_API_KEY=

# Controlled target site
TARGET_SITE_PORT=3001
TARGET_CONTROL_TOKEN=replace-with-a-long-random-value
TARGET_STATE_PATH=./data/target-scenario.json
